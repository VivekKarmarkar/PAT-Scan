\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Pre-training state (iteration 0) with random U-Net initialization. Left: ground truth material distribution with circular inclusion (red, $E = 10$) in background (blue, $E = 1$). Center: U-Net continuous prediction showing random material assignment (SSIM $\approx 0.06$). Right: level-set hard boundary extraction from the random prediction, bearing no resemblance to the true inclusion.}}{20}{figure.1}\protected@file@percent }
\newlabel{fig:pre_training}{{1}{20}{Pre-training state (iteration 0) with random U-Net initialization. Left: ground truth material distribution with circular inclusion (red, $E = 10$) in background (blue, $E = 1$). Center: U-Net continuous prediction showing random material assignment (SSIM $\approx 0.06$). Right: level-set hard boundary extraction from the random prediction, bearing no resemblance to the true inclusion}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Baseline reconstruction after 1000 iterations using only L2 displacement loss (no regularization). The U-Net localizes the inclusion (SSIM = 0.72, accuracy = 87.8\%) but the predicted boundary is diffuse with spatial noise, demonstrating the need for regularization.}}{21}{figure.2}\protected@file@percent }
\newlabel{fig:vanilla}{{2}{21}{Baseline reconstruction after 1000 iterations using only L2 displacement loss (no regularization). The U-Net localizes the inclusion (SSIM = 0.72, accuracy = 87.8\%) but the predicted boundary is diffuse with spatial noise, demonstrating the need for regularization}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Reconstruction with TV regularization, Gaussian smoothing, and level-set post-processing after 1000 iterations (SSIM = 0.91, accuracy = 94.6\%). The predicted inclusion boundary is crisp and closely matches the ground truth circular geometry, confirming the effectiveness of the composite loss function.}}{21}{figure.3}\protected@file@percent }
\newlabel{fig:post_training_full}{{3}{21}{Reconstruction with TV regularization, Gaussian smoothing, and level-set post-processing after 1000 iterations (SSIM = 0.91, accuracy = 94.6\%). The predicted inclusion boundary is crisp and closely matches the ground truth circular geometry, confirming the effectiveness of the composite loss function}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Grid-search-optimized reconstruction after only 200 iterations (SSIM = 0.85, accuracy = 94.6\%). Systematic hyperparameter tuning achieves comparable accuracy to the untuned result (Figure\nobreakspace  {}\ref  {fig:post_training_full}) in one-fifth the iterations.}}{22}{figure.4}\protected@file@percent }
\newlabel{fig:grid_search}{{4}{22}{Grid-search-optimized reconstruction after only 200 iterations (SSIM = 0.85, accuracy = 94.6\%). Systematic hyperparameter tuning achieves comparable accuracy to the untuned result (Figure~\ref {fig:post_training_full}) in one-fifth the iterations}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Faint inclusion reconstruction ($\alpha = 1.2$, SSIM = 0.81, accuracy = 93.0\%). Despite the low stiffness contrast producing subtle boundary displacement differences, the method successfully detects and localizes the inclusion with graceful quality degradation.}}{22}{figure.5}\protected@file@percent }
\newlabel{fig:faint}{{5}{22}{Faint inclusion reconstruction ($\alpha = 1.2$, SSIM = 0.81, accuracy = 93.0\%). Despite the low stiffness contrast producing subtle boundary displacement differences, the method successfully detects and localizes the inclusion with graceful quality degradation}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Smaller inclusion reconstruction (SSIM = 0.40, accuracy = 88.5\%). The inclusion location is correctly identified, but boundary geometry is less precisely recovered due to the weaker displacement signal produced by the reduced inclusion size.}}{22}{figure.6}\protected@file@percent }
\newlabel{fig:smaller}{{6}{22}{Smaller inclusion reconstruction (SSIM = 0.40, accuracy = 88.5\%). The inclusion location is correctly identified, but boundary geometry is less precisely recovered due to the weaker displacement signal produced by the reduced inclusion size}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Most challenging scenario: small inclusion with faint contrast ($\alpha = 1.2$, SSIM = 0.49, accuracy = 89.5\%). The inclusion is detected and approximately localized, representing the sensitivity limit of the current methodology.}}{23}{figure.7}\protected@file@percent }
\newlabel{fig:small_faint}{{7}{23}{Most challenging scenario: small inclusion with faint contrast ($\alpha = 1.2$, SSIM = 0.49, accuracy = 89.5\%). The inclusion is detected and approximately localized, representing the sensitivity limit of the current methodology}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Robustness to initialization demonstrated across multiple independent runs. Each run uses identical training procedure and data with different random seeds. The reconstructions achieve consistent SSIM values above 0.90 with visually similar inclusion boundaries, confirming that the optimizer converges to the same solution regardless of initialization.}}{23}{figure.8}\protected@file@percent }
\newlabel{fig:sensitivity}{{8}{23}{Robustness to initialization demonstrated across multiple independent runs. Each run uses identical training procedure and data with different random seeds. The reconstructions achieve consistent SSIM values above 0.90 with visually similar inclusion boundaries, confirming that the optimizer converges to the same solution regardless of initialization}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Summary of reliability study findings: accuracy consistently above 80\%, reduced sensitivity to initial conditions, and no spurious local minima. The tight clustering across runs motivates a practical ensemble strategy where the practitioner runs the algorithm 3--5 times, discards outliers, and averages the clustered results.}}{24}{figure.9}\protected@file@percent }
\newlabel{fig:reliability_summary}{{9}{24}{Summary of reliability study findings: accuracy consistently above 80\%, reduced sensitivity to initial conditions, and no spurious local minima. The tight clustering across runs motivates a practical ensemble strategy where the practitioner runs the algorithm 3--5 times, discards outliers, and averages the clustered results}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Irregular inclusion reconstruction without learning rate optimization (SSIM = 0.21, approximately 13 minutes). The reconstruction fails to capture the complex boundary shape, highlighting the sensitivity of irregular geometries to hyperparameter selection. The training loss curve (bottom) shows convergence but to a poor local minimum.}}{25}{figure.10}\protected@file@percent }
\newlabel{fig:irregular_no_lr}{{10}{25}{Irregular inclusion reconstruction without learning rate optimization (SSIM = 0.21, approximately 13 minutes). The reconstruction fails to capture the complex boundary shape, highlighting the sensitivity of irregular geometries to hyperparameter selection. The training loss curve (bottom) shows convergence but to a poor local minimum}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Irregular inclusion reconstruction with learning rate optimization (SSIM = 0.80, accuracy = 92.7\%, approximately 17 minutes). The same U-Net architecture generalizes to non-convex, off-centered inclusion geometry without architectural modifications. The predicted boundary captures the overall shape and location, with the loss curve (bottom) showing stable convergence.}}{26}{figure.11}\protected@file@percent }
\newlabel{fig:irregular_lr}{{11}{26}{Irregular inclusion reconstruction with learning rate optimization (SSIM = 0.80, accuracy = 92.7\%, approximately 17 minutes). The same U-Net architecture generalizes to non-convex, off-centered inclusion geometry without architectural modifications. The predicted boundary captures the overall shape and location, with the loss curve (bottom) showing stable convergence}{figure.11}{}}
